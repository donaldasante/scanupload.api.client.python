"""Example configuration file for testing."""

# ScanUpload API client configuration
#
# Copy this file to `.env` and fill in the values supplied by your
# ScanUpload administrator. Values can also be supplied directly through
# the shell environment; names match the fields on `ScanUploadOptions`.

# Keycloak client credentials flow - required.
KEYCLOAK_SERVER_URL=https://identity.scanupload.net/
KEYCLOAK_REALM=scanupload-hub
KEYCLOAK_CLIENT_ID=your-client-id
KEYCLOAK_CLIENT_SECRET=your-client-secret

# Optional: OAuth2 scope requested from Keycloak.
KEYCLOAK_SCOPE=openid profile email scanupload.hub

# Hub base URL used by ScanUploadApiClient (only required when running
# examples/quickstart.py or examples/integration_test.py). The bearer
# token authorizes calls to this host's
# `/api/file-management/download-session/{session_id}` endpoint.
HUB_BASE_URL=https://hub.scanupload.net

# Session ID to download when running examples/quickstart.py or hitting
# /download-file/{session_id} on examples/integration_test.py.
SESSION_ID=your-session-id

# Optional: bind address and TLS for examples/integration_test.py.
# Defaults to https on localhost:7021 to match the .NET test host.
UVICORN_HOST=localhost
UVICORN_PORT=7021
# UVICORN_SSL_CERTFILE=C:/path/to/localhost.pem
# UVICORN_SSL_KEYFILE=C:/path/to/localhost-key.pem
